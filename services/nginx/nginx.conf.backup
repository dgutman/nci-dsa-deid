worker_processes 1;

events { worker_connections 1024; }

error_log  /var/log/nginx/error.log debug;

http {
        # include /etc/nginx/conf.d/envvar.conf;
        
        # Map for WebSocket connection upgrade (only upgrade if Upgrade header is present)
        map $http_upgrade $connection_upgrade {
            default upgrade;
            ''      '';
        }

        sendfile on;  # Enable sendfile for better file transfer performance
        tcp_nopush on;  # Optimize TCP packets when using sendfile
        tcp_nodelay on;  # Disable Nagle's algorithm for lower latency
        proxy_max_temp_file_size 0;
        # proxy_buffering off;  # Only disable for SSE endpoints, not globally
        # Match host nginx's client_max_body_size (500M) to avoid upload issues
        client_max_body_size 500m;

        upstream docker-node {
                server node:8080;
        }
        upstream docker-dsa{
                server girder:8080;
                keepalive 32;  # Maintain up to 32 keepalive connections to reduce latency
                keepalive_timeout 300s;  # Keep connections alive for 5 minutes
                keepalive_requests 1000;  # Allow up to 1000 requests per connection before closing
        }
        upstream docker-dashdeid {
                server dashdeid:8050;
        }
        upstream docker-reactdeid {
                server reactdeid:5173;
        }


        include /etc/nginx/conf.d/redirect_http.conf;


        server {
                listen 80;
                include /etc/nginx/conf.d/use_https.conf; # If this is enabled via enviroment variable, the server will also listen on https

                server_name _;
                
                # Easter egg for testing
                location ~* ^/oppan(?:/.*|$) { 
                        return 200 'Gangnam style!';
                        add_header Content-Type text/plain;
                }


                # Temporary fix:
                # Pass /api/v1/describe to docker-dsa upstream (girder service)
                location ~* ^/api/v1/describe(?:/.*|$) { 
                        proxy_pass http://docker-dsa;
                        # Preserve forwarded headers from upstream proxy
                        proxy_set_header Host $proxy_host;
                        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                        set $forwarded_host $http_x_forwarded_host;
                        if ($forwarded_host = "") {
                            set $forwarded_host $host;
                        }
                        proxy_set_header X-Forwarded-Host $forwarded_host;
                        set $forwarded_proto $http_x_forwarded_proto;
                        if ($forwarded_proto = "") {
                            set $forwarded_proto $scheme;
                        }
                        proxy_set_header X-Forwarded-Proto $forwarded_proto;
                }

                # Pass /api and subroutes along to the docker-node upstream (node service; expressjs API server)
                location ~* ^/api(?:/.*|$) { 
                        rewrite ^/api/*(.*)$ /$1 break;
                        proxy_pass http://docker-node;
                        proxy_redirect     off;
                        proxy_set_header   Host $host;
                        proxy_set_header   X-Real-IP $remote_addr;
                        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
                        # Preserve X-Forwarded-Host from upstream, fallback to $host
                        set $forwarded_host $http_x_forwarded_host;
                        if ($forwarded_host = "") {
                            set $forwarded_host $host;
                        }
                        proxy_set_header   X-Forwarded-Host $forwarded_host;
                        set $forwarded_proto $http_x_forwarded_proto;
                        if ($forwarded_proto = "") {
                            set $forwarded_proto $scheme;
                        }
                        proxy_set_header   X-Forwarded-Proto $forwarded_proto;
                        proxy_set_header   Cookie $http_cookie;
                }


                # Pass /dsa to docker-dsa upstream (girder service)
                location ~* ^/dsa(?:/.*|$) { 
                        rewrite ^/dsa/*(.*)$ /$1 break;
                        proxy_pass http://docker-dsa;

                        # For tools.proxy.on = True, Girder uses X-Forwarded-Host and X-Forwarded-Proto
                        # to construct API URLs. We need to preserve the headers from the upstream proxy.
                        proxy_set_header Host $proxy_host; # Internal hostname for upstream
                        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                        # Preserve X-Forwarded-Host from upstream (host nginx) if present,
                        # otherwise use $host. This ensures OAuth redirect URIs use the correct external domain.
                        # The host nginx sets X-Forwarded-Host to wsi-deid.pathology.emory.edu
                        set $forwarded_host $http_x_forwarded_host;
                        if ($forwarded_host = "") {
                            set $forwarded_host $host;
                        }
                        proxy_set_header X-Forwarded-Host $forwarded_host;
                        # Preserve X-Forwarded-Proto from upstream if present, otherwise use $scheme
                        set $forwarded_proto $http_x_forwarded_proto;
                        if ($forwarded_proto = "") {
                            set $forwarded_proto $scheme;
                        }
                        proxy_set_header X-Forwarded-Proto $forwarded_proto;
                       
                        # Use keepalive connections for better performance
                        proxy_http_version 1.1;
                        proxy_set_header Connection "";  # Empty Connection header enables keepalive
                        # Note: keepalive_timeout and keepalive_requests are set in the upstream block
                       
                        # Disable buffering for SSE compatibility (Girder notifications)
                        # This is necessary for SSE to work, but may slightly impact performance
                        # for regular API requests. The keepalive connections help offset this.
                        proxy_buffering off;
                        proxy_cache off;
                        chunked_transfer_encoding off;
                       
                        proxy_read_timeout 600s;
                        proxy_send_timeout 600s;
                        # proxy_request_buffering option only works on nginx >= 1.7.11
                        # but is necessary to support streaming requests
                        proxy_request_buffering off;
                        
                }

                # Temporary fix:
                # Pass /plugin_static to docker-dsa upstream (girder service)
                location ~* ^/plugin_static(?:/.*|$) { 
                        proxy_pass http://docker-dsa;
                        # Preserve forwarded headers from upstream proxy
                        proxy_set_header Host $proxy_host;
                        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                        set $forwarded_host $http_x_forwarded_host;
                        if ($forwarded_host = "") {
                            set $forwarded_host $host;
                        }
                        proxy_set_header X-Forwarded-Host $forwarded_host;
                        set $forwarded_proto $http_x_forwarded_proto;
                        if ($forwarded_proto = "") {
                            set $forwarded_proto $scheme;
                        }
                        proxy_set_header X-Forwarded-Proto $forwarded_proto;
                }

                # Redirect /deid to /deid/ (Vite requires trailing slash for base path)
                # Use absolute redirect to prevent redirecting to localhost
                location = /deid {
                        return 301 $scheme://$host/deid/;
                }
                
                # Pass /deid/ to docker-reactdeid upstream (reactdeid service - React/Vite app)
                location ~* ^/deid/(?:.*|$) {
                        # Forward the full path including /deid/ to Vite (Vite base is /deid/)
                        proxy_pass http://docker-reactdeid;
                        
                        proxy_set_header Host $http_host;
                        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                        # Preserve X-Forwarded-Host from upstream, fallback to $host
                        set $forwarded_host $http_x_forwarded_host;
                        if ($forwarded_host = "") {
                            set $forwarded_host $host;
                        }
                        proxy_set_header X-Forwarded-Host $forwarded_host;
                        set $forwarded_proto $http_x_forwarded_proto;
                        if ($forwarded_proto = "") {
                            set $forwarded_proto $scheme;
                        }
                        proxy_set_header X-Forwarded-Proto $forwarded_proto;
                        proxy_set_header X-Real-IP $remote_addr;
                        
                        # WebSocket support for Vite HMR (only upgrade if Upgrade header is present)
                        proxy_http_version 1.1;
                        proxy_set_header Upgrade $http_upgrade;
                        # Use the map defined at http level to conditionally set Connection header
                        proxy_set_header Connection $connection_upgrade;
                        proxy_read_timeout 86400;
                        
                        # Ensure proper MIME types for JavaScript modules
                        proxy_set_header Accept $http_accept;
                }


                # Pass / (root) to the docker-react upstream (react service)
                # location ~* ^/(?:/.*|$)? {
                #         proxy_pass http://docker-react;
                # }
                
                # Fallback route - show the splash page
                location / {
                        root /etc/nginx/html;
                        try_files $uri $uri/ /index.html;
                        add_header Content-Type text/html;
                }

        }
       

}

